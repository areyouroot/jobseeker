                        "index": 0
                    }
                ]
            ]
        },
        "search-ddg": {
            "main": [
                [
                    {
                        "node": "parse-html",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "parse-html": {
            "main": [
                [
                    {
                        "node": "flatten-results",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "flatten-results": {
            "main": [
                [
                    {
                        "node": "ollama-filter-req",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "ollama-filter-req": {
            "main": [
                [
                    {
                        "node": "filter-80",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "filter-80": {
            "main": [
                [
                    {
                        "node": "ollama-letter-req",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "ollama-letter-req": {
            "main": [
                [
                    {
                        "node": "save-results",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    }
}