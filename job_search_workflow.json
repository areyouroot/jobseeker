                        "index": 0
                    }
                ]
            ]
        },
        "extract-text": {
            "main": [
                [
                    {
                        "node": "prepare-queries",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "prepare-queries": {
            "main": [
                [
                    {
                        "node": "split-loop",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "split-loop": {
            "main": [
                [
                    {
                        "node": "search-ddg",
