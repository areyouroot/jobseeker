[naukri]
email = email@email.com
password = password123

[settings]
# Path to the resume file inside the resume folder
resume_filename = resume.pdf

# Browser settings
slow_mo = 100
# Timeout in milliseconds for waiting on elements
timeout = 30000
# Delay in seconds after uploading the resume
upload_delay = 10
# Delay in seconds after applying to a job
apply_delay = 60

[schedule]
# Comma-separated times (24-hour format HH:MM) to upload the resume each day.
# The script will upload at each of these times while it is running.
times = 09:00, 13:00, 16:00, 23:43

[telegram]
# Telegram Bot integration for NVite question relaying.
# Create a bot via @BotFather and get the token.
# Get your chat_id by messaging @userinfobot on Telegram.
bot_token = YOUR_TELEGRAM_BOT_TOKEN
chat_id = YOUR_TELEGRAM_CHAT_ID

[llm]
# URL of your local LLM model (e.g. n8n workflow or local chat API)
url = YOUR_LOCAL_LLM_WEBHOOK_URL

