# Stage 1: Build
FROM oven/bun:1.2.14 AS build
WORKDIR /app

# Copy package files
COPY frontend/package.json frontend/bun.lock ./
RUN bun install

# Copy source code
COPY frontend/ .
RUN bun run build

# Stage 2: Serve
FROM nginx:alpine
COPY --from=build /app/dist/frontend/browser /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
